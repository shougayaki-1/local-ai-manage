{
  "name": "local-ai-manage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test test/*.test.ts && npm run test:engine",
    "start": "node dist/server/cli.js",
    "demo": "node dist/server/cli.js --demo",
    "test:engine": "node --test engine/care-record/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.1.0",
    "eslint": "9.39.4",
    "typescript-eslint": "8.57.0"
  }
}
