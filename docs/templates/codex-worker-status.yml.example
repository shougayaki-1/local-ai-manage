# Inactive template. Install only after stopping every direct comment writer.
name: Codex Worker sole status writer
on:
  workflow_dispatch:
    inputs:
      payload:
        description: Sanitized status envelope; empty performs stale inspection
        required: false
        type: string
  schedule:
    - cron: '7,17,27,37,47,57 * * * *'
permissions:
  contents: read
  issues: write
concurrency:
  group: codex-worker-status-sole-writer
  cancel-in-progress: false
jobs:
  status:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/setup-node@v5
        with:
          node-version: '24'
          package-manager-cache: false
      - name: Read fixed status scripts from this reviewed commit
        env:
          GH_TOKEN: ${{ github.token }}
          STATUS_SOURCE_REF: ${{ github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          [[ "$STATUS_SOURCE_REF" =~ ^[a-f0-9]{40}$ ]]
          mkdir -p engine
          gh api "repos/$GITHUB_REPOSITORY/contents/engine/status-monitor.mjs?ref=$STATUS_SOURCE_REF" --jq .content | base64 --decode > engine/status-monitor.mjs
          gh api "repos/$GITHUB_REPOSITORY/contents/engine/status-writer.mjs?ref=$STATUS_SOURCE_REF" --jq .content | base64 --decode > engine/status-writer.mjs
      - name: Update fixed status comment
        env:
          GH_TOKEN: ${{ github.token }}
          STATUS_ISSUE: ${{ vars.CODEX_STATUS_ISSUE }}
          STATUS_COMMENT: ${{ vars.CODEX_STATUS_COMMENT }}
          STATUS_PAYLOAD: ${{ inputs.payload }}
        run: node engine/status-writer.mjs
